{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "BlitzDev FinTech PR Guardian",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "FIN-001",
              "name": "FloatCurrencyPrecisionDrift",
              "shortDescription": {
                "text": "Float Currency Precision Drift"
              },
              "fullDescription": {
                "text": "Using IEEE 754 float types for money fields can lead to precision loss and fractional-cent drift."
              },
              "help": {
                "text": "Enforce decimal.Decimal or integer cents with explicit quantization."
              }
            },
            {
              "id": "FIN-002",
              "name": "MissingRow-LevelConcurrencyLock",
              "shortDescription": {
                "text": "Missing Row-Level Concurrency Lock"
              },
              "fullDescription": {
                "text": "Missing serialized mutex locks or SELECT FOR UPDATE during concurrent balance updates."
              },
              "help": {
                "text": "Acquire an asynchronous mutex lock or use with_for_update() on balance reads."
              }
            },
            {
              "id": "FIN-004",
              "name": "UnvalidatedIdempotencyKey",
              "shortDescription": {
                "text": "Unvalidated Idempotency Key"
              },
              "fullDescription": {
                "text": "Accepting an idempotency_key without verifying previous execution allows double-charging on network retry."
              },
              "help": {
                "text": "Query database for key existence inside transaction boundary before mutating balances."
              }
            },
            {
              "id": "FIN-005",
              "name": "MissingAuthenticationDependency",
              "shortDescription": {
                "text": "Missing Authentication Dependency"
              },
              "fullDescription": {
                "text": "Financial ledger mutation endpoints declared without Depends() security guards."
              },
              "help": {
                "text": "Add authentication guards such as Depends(get_current_user) to all routes."
              }
            },
            {
              "id": "FIN-006",
              "name": "MissingRollbackExceptionGuard",
              "shortDescription": {
                "text": "Missing Rollback Exception Guard"
              },
              "fullDescription": {
                "text": "Database session operations without explicit await session.rollback() on exception."
              },
              "help": {
                "text": "Include explicit await session.rollback() inside exception handling blocks."
              }
            },
            {
              "id": "FIN-007",
              "name": "MissingDecimalModuleImport",
              "shortDescription": {
                "text": "Missing Decimal Module Import"
              },
              "fullDescription": {
                "text": "Financial arithmetic detected in module without explicit decimal.Decimal import."
              },
              "help": {
                "text": "Import and use decimal.Decimal for all monetary calculations."
              }
            }
          ]
        }
      },
