{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "BlitzDev FinTech Security Auditor",
          "version": "1.0.0",
          "informationUri": "https://github.com/royal-code-blitzdev",
          "rules": [
            {
              "id": "FIN-001",
              "name": "FloatCurrencyPrecision",
              "shortDescription": {
                "text": "Currency columns must use Decimal/Numeric, not Float."
              },
              "fullDescription": {
                "text": "IEEE-754 binary floating-point cannot represent decimal fractions exactly. Using Float for currency balances or amounts causes deterministic rounding drift that compounds across transactions, violating ledger integrity."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://docs.python.org/3/library/decimal.html"
            },
            {
              "id": "FIN-002",
              "name": "MissingRowLock",
              "shortDescription": {
                "text": "Balance reads prior to mutation must use SELECT FOR UPDATE."
              },
              "fullDescription": {
                "text": "Reading a mutable account balance without a row-level lock (SELECT FOR UPDATE / with_for_update()) allows concurrent requests to read the same stale value and both proceed past the balance check, causing overdraft race conditions."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "FIN-003",
              "name": "NonAtomicTransfer",
              "shortDescription": {
                "text": "Dual-entry ledger operations must use a single atomic transaction."
              },
              "fullDescription": {
                "text": "Committing the debit leg and the credit leg of a transfer in separate database transactions creates a window where a crash, OOM, or network failure permanently corrupts the ledger by leaving one leg orphaned."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "FIN-004",
              "name": "MissingIdempotencyCheck",
              "shortDescription": {
                "text": "Idempotency keys must be validated before processing mutations."
              },
              "fullDescription": {
                "text": "Accepting an idempotency key in the request without querying the database to detect duplicates before executing mutations allows retried or replayed requests to double-credit or double-debit accounts."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "FIN-005",
              "name": "MissingAuthMiddleware",
              "shortDescription": {
                "text": "Balance mutation routes must enforce authentication."
              },
              "fullDescription": {
                "text": "Routes that mutate account balances (/withdraw, /transfer, /deposit) must require authenticated identity via an auth dependency. Unauthenticated access allows any caller to arbitrarily modify balances."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "FIN-006",
              "name": "BareExceptionHandler",
              "shortDescription": {
                "text": "Transaction error handlers must call await session.rollback()."
              },
              "fullDescription": {
                "text": "Exception paths in async database handlers that do not explicitly call await session.rollback() leave the SQLAlchemy session in an indeterminate state, risking partial commits or connection pool exhaustion."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "FIN-007",
              "name": "MissingDecimalImport",
              "shortDescription": {
                "text": "The decimal module must be imported and used for currency arithmetic."
              },
              "fullDescription": {
                "text": "Currency arithmetic must use decimal.Decimal to prevent IEEE-754 float rounding drift. If the module is not imported, all balance calculations silently operate on floating-point, regardless of the column type."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "FIN-001",
          "level": "error",
          "message": {
            "text": "Column 'balance' in class Account uses Float instead of Numeric(18,4) or Integer cents. IEEE-754 rounding drift will accumulate across every balance mutation."
          },
